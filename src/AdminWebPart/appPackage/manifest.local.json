{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
    "manifestVersion": "1.16",
    "id": "${{TEAMS_APP_ID}}",
    "version": "1.1.1",
    "isFullScreen": true,
    "developer": {
        "name": "AMVCC",
        "websiteUrl": "https://www.amvcc.com",
        "privacyUrl": "https://www.amvcc.com",
        "termsOfUseUrl": "https://www.amvcc.com"
    },
    "name": {
        "short": "ShortUrlV2${{APP_NAME_SUFFIX}}",
        "full": "ShortUrlV2 - Administration AMVCC"
    },
    "description": {
        "short": "Administration sécurisée des liens courts AMVCC",
        "full": "Créer, modifier et archiver les liens courts AMVCC depuis SharePoint ou Microsoft Teams."
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "accentColor": "#004578",
    "staticTabs": [
        {
            "entityId": "4bbafe50-8842-4630-b2fb-463334ac9d61",
            "name": "ShortUrlV2",
            "contentUrl": "https://{teamSiteDomain}/_layouts/15/TeamsLogon.aspx?SPFX=true&dest={teamSitePath}/_layouts/15/TeamsWorkBench.aspx%3FcomponentId=4bbafe50-8842-4630-b2fb-463334ac9d61%26teams%26personal%26forceLocale={locale}%26loadSPFX%3Dtrue%26debugManifestsFile%3Dhttps%3A%2F%2Flocalhost%3A4321%2Ftemp%2Fmanifests.js",
            "websiteUrl": "https://products.office.com/en-us/sharepoint/collaboration",
